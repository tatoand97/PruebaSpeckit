{
  "Logging": {
    "LogLevel": {
      "Default": "None",
      "Orders.Api": "Information",
      "Microsoft": "None",
      "Microsoft.AspNetCore": "None",
      "Microsoft.Data.Sqlite": "None",
      "Microsoft.Hosting.Lifetime": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "JsonWriterOptions": {
          "Indented": false
        },
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}

