{
	"servers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"type": "http"
		},
		"graphify": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"graphifyy[mcp]",
				"python",
				"-m",
				"graphify.serve",
				"${workspaceFolder}/graphify-out/graph.json"
			],
			"cwd": "${workspaceFolder}"
		}
	},
	"inputs": []
}